# Build output. This directory is generated by CMake and contains the compiled
# binaries plus the whole downloaded copy of raylib - hundreds of megabytes,
# all of it reproducible from source. It must never be committed.
build/
out/

# Visual Studio
.vs/
*.user
*.suo

# VS Code (keep shared settings, ignore per-machine noise)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# CLion / JetBrains
.idea/
cmake-build-*/

# Compiled artifacts
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.obj
*.o
*.a

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
